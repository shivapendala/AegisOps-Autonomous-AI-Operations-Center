# Backend Environment Configuration
APP_NAME="AegisOps - Autonomous AI Operations Center"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# CORS Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aegisops"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/aegisops"
DB_FALLBACK_SQLITE=true

# AI / LLM Configuration
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"
ANOMALY_DETECTION_CONTAMINATION=0.05

# Telemetry
METRICS_POLL_INTERVAL_SECONDS=2
LOG_LEVEL="INFO"
