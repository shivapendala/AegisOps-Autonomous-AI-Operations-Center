# AegisOps Environment Configuration

# Server Settings
APP_NAME="AegisOps - Autonomous AI Operations Center"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
# Primary: PostgreSQL. If unreachable in local dev, SQLAlchemy session falls back cleanly to local SQLite.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aegisops"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/aegisops"
DB_FALLBACK_SQLITE=true

# AI Layer & LLM Configuration
# Options: mock, openai, anthropic
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"
ANOMALY_DETECTION_CONTAMINATION=0.05

# Telemetry & Monitoring Settings
METRICS_POLL_INTERVAL_SECONDS=2
METRICS_HISTORY_LIMIT=120
LOG_LEVEL="INFO"
