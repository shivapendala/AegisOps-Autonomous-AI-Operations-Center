# AegisOps Environment Configuration Template
# Duplicate this file to .env and customize as needed. Never commit .env with real secrets.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
APP_NAME="AegisOps - Autonomous AI Operations Center"
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated origins allowed to access the backend)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# In Docker Compose, the database hostname is 'postgres'.
# For local standalone dev without Docker, use 'localhost'.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegisops
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aegisops"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/aegisops"
DB_FALLBACK_SQLITE=true

# ------------------------------------------------------------------------------
# 3. AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'mock' (default zero-dependency, works offline), 'openai', 'anthropic'
LLM_PROVIDER=mock
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"
ANOMALY_DETECTION_CONTAMINATION=0.05

# ------------------------------------------------------------------------------
# 4. Telemetry & Monitoring Settings
# ------------------------------------------------------------------------------
METRICS_POLL_INTERVAL_SECONDS=2.0
METRICS_HISTORY_LIMIT=120
LOG_LEVEL=INFO
